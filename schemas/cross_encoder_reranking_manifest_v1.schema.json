{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://educational-knowledge-platform.local/schemas/cross_encoder_reranking_manifest_v1.schema.json",
  "title": "MIT 6.0001 Cross-Encoder Reranking Manifest v1",
  "description": "Audit manifest for reranking Dense Top 50 candidates with a pinned Cross-Encoder.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schema_version", "reranking_run_id", "reranking_version",
    "scope_version", "canonical_gold_file", "canonical_gold_sha256",
    "evaluation_file", "evaluation_sha256", "dense_index_manifest_file",
    "dense_index_manifest_sha256", "dense_index_content_sha256",
    "retrieval_decision_file", "retrieval_decision_sha256",
    "selected_retrieval_method", "dense_model_repository", "dense_model_revision",
    "reranker_model_repository", "reranker_model_revision", "reranker_actual_revision",
    "reranker_model_weights_sha256", "reranker_snapshot_file_count",
    "reranker_snapshot_content_sha256", "model_cache_policy", "device",
    "candidate_depth", "output_top_k", "max_length", "batch_size",
    "score_function", "ranking_tie_break", "question_count",
    "excluded_out_of_scope_question_count", "ground_truth_range_count",
    "corpus_chunk_count", "candidate_pair_count", "candidate_first_relevant_count",
    "candidate_full_evidence_count", "pair_token_length_max", "truncated_pair_count",
    "relevance_rule", "dense_baseline_metrics_match",
    "dense_top_10_id_match_count", "dense_top_10_score_match_count",
    "results_file", "results_sha256", "comparison_file", "comparison_sha256",
    "question_comparison_file", "question_comparison_sha256",
    "validation_file", "validation_sha256", "python_version", "numpy_version",
    "torch_version", "transformers_version", "sentence_transformers_version",
    "selection_status", "validation_status"
  ],
  "properties": {
    "$schema": {"const": "../../schemas/cross_encoder_reranking_manifest_v1.schema.json"},
    "schema_version": {"const": "cross_encoder_reranking_manifest_v1"},
    "reranking_run_id": {"type": "string", "pattern": "^mit60001_rerank_[a-f0-9]{16}$"},
    "reranking_version": {"const": "mit60001_cross_encoder_reranking_v1"},
    "scope_version": {"const": "mit_60001_fall_2016_v1"},
    "canonical_gold_file": {"const": "data/gold/mit_60001/chunks.jsonl"},
    "canonical_gold_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evaluation_file": {"const": "evaluation/mit_60001/evaluation_questions.jsonl"},
    "evaluation_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "dense_index_manifest_file": {"const": "reports/09_embedding/embedding_index_manifest.json"},
    "dense_index_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "dense_index_content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "retrieval_decision_file": {"const": "reports/10_retrieval/retrieval_configuration_decision_2026-08-14.csv"},
    "retrieval_decision_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "selected_retrieval_method": {"const": "dense_baseline_v1"},
    "dense_model_repository": {"const": "sentence-transformers/all-MiniLM-L6-v2"},
    "dense_model_revision": {"const": "1110a243fdf4706b3f48f1d95db1a4f5529b4d41"},
    "reranker_model_repository": {"const": "cross-encoder/ms-marco-MiniLM-L6-v2"},
    "reranker_model_revision": {"const": "c5ee24cb16019beea0893ab7796b1df96625c6b8"},
    "reranker_actual_revision": {"const": "c5ee24cb16019beea0893ab7796b1df96625c6b8"},
    "reranker_model_weights_sha256": {"const": "821d1aa69520101d6e0737f78a042ae25b19e5cb9160701909d10434f4aeb0ae"},
    "reranker_snapshot_file_count": {"type": "integer", "minimum": 1},
    "reranker_snapshot_content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "model_cache_policy": {"const": "project_local_gitignored_data_models"},
    "device": {"const": "cpu"},
    "candidate_depth": {"const": 50},
    "output_top_k": {"const": 3},
    "max_length": {"const": 512},
    "batch_size": {"const": 16},
    "score_function": {"const": "raw_identity_logit_float32"},
    "ranking_tie_break": {"const": "score_desc_then_dense_rank_asc_then_chunk_id_asc"},
    "question_count": {"const": 35},
    "excluded_out_of_scope_question_count": {"const": 5},
    "ground_truth_range_count": {"const": 57},
    "corpus_chunk_count": {"const": 861},
    "candidate_pair_count": {"const": 1750},
    "candidate_first_relevant_count": {"const": 35},
    "candidate_full_evidence_count": {"const": 35},
    "pair_token_length_max": {"type": "integer", "minimum": 1},
    "truncated_pair_count": {"type": "integer", "minimum": 0},
    "relevance_rule": {"const": "same_video_and_source_segment_interval_intersection"},
    "dense_baseline_metrics_match": {"const": true},
    "dense_top_10_id_match_count": {"const": 35},
    "dense_top_10_score_match_count": {"const": 35},
    "results_file": {"const": "reports/11_reranking/cross_encoder_reranking_results.csv"},
    "results_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "comparison_file": {"const": "reports/11_reranking/cross_encoder_reranking_comparison.csv"},
    "comparison_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "question_comparison_file": {"const": "reports/11_reranking/cross_encoder_reranking_question_comparison.csv"},
    "question_comparison_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "validation_file": {"const": "reports/11_reranking/cross_encoder_reranking_validation.csv"},
    "validation_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "python_version": {"type": "string", "minLength": 1},
    "numpy_version": {"type": "string", "minLength": 1},
    "torch_version": {"type": "string", "minLength": 1},
    "transformers_version": {"type": "string", "minLength": 1},
    "sentence_transformers_version": {"type": "string", "minLength": 1},
    "selection_status": {"const": "pending_human_decision"},
    "validation_status": {"const": "passed"}
  }
}
