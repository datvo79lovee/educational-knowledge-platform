{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://educational-knowledge-platform.local/schemas/embedding_index_manifest_v1.schema.json",
  "title": "MIT 6.0001 Embedding Index Manifest v1",
  "description": "Audit manifest for the exact dense index built from canonical Gold chunks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schema_version", "index_run_id", "index_created_at_utc",
    "index_version", "scope_version", "index_backend", "similarity",
    "canonical_gold_file", "canonical_gold_sha256",
    "canonical_gold_manifest_file", "canonical_gold_manifest_sha256",
    "selected_chunking_config_id", "chunk_count", "video_count",
    "chunk_id_order_sha256", "model_repository", "model_revision",
    "model_max_sequence_length", "embedding_dimension", "embedding_dtype",
    "normalize_embeddings", "batch_size", "norm_tolerance",
    "embeddings_file", "embeddings_sha256", "embedding_shape",
    "metadata_file", "metadata_sha256", "metadata_record_count",
    "index_content_sha256", "python_version", "numpy_version", "torch_version",
    "transformers_version", "sentence_transformers_version",
    "nonfinite_value_count", "zero_norm_vector_count", "norm_violation_count",
    "validation_status"
  ],
  "properties": {
    "$schema": {"const": "../../schemas/embedding_index_manifest_v1.schema.json"},
    "schema_version": {"const": "embedding_index_manifest_v1"},
    "index_run_id": {"type": "string", "pattern": "^mit60001_index_[a-f0-9]{16}$"},
    "index_created_at_utc": {"type": "string", "format": "date-time"},
    "index_version": {"const": "mit60001_exact_dense_v1"},
    "scope_version": {"const": "mit_60001_fall_2016_v1"},
    "index_backend": {"const": "numpy_exact_cosine_v1"},
    "similarity": {"const": "cosine_via_dot_product_of_l2_normalized_vectors"},
    "canonical_gold_file": {"const": "data/gold/mit_60001/chunks.jsonl"},
    "canonical_gold_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "canonical_gold_manifest_file": {"const": "reports/08_chunking/canonical_gold_manifest.json"},
    "canonical_gold_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "selected_chunking_config_id": {"const": "semantic_cosine_wp240_v1"},
    "chunk_count": {"const": 861},
    "video_count": {"const": 38},
    "chunk_id_order_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "model_repository": {"const": "sentence-transformers/all-MiniLM-L6-v2"},
    "model_revision": {"const": "1110a243fdf4706b3f48f1d95db1a4f5529b4d41"},
    "model_max_sequence_length": {"type": "integer", "minimum": 1},
    "embedding_dimension": {"const": 384},
    "embedding_dtype": {"const": "float32"},
    "normalize_embeddings": {"const": true},
    "batch_size": {"const": 32},
    "norm_tolerance": {"const": 1e-05},
    "embeddings_file": {"const": "data/indexes/mit_60001/embeddings.npy"},
    "embeddings_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "embedding_shape": {
      "type": "array",
      "prefixItems": [{"const": 861}, {"const": 384}],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "metadata_file": {"const": "data/indexes/mit_60001/metadata.jsonl"},
    "metadata_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "metadata_record_count": {"const": 861},
    "index_content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "python_version": {"type": "string", "minLength": 1},
    "numpy_version": {"type": "string", "minLength": 1},
    "torch_version": {"type": "string", "minLength": 1},
    "transformers_version": {"type": "string", "minLength": 1},
    "sentence_transformers_version": {"type": "string", "minLength": 1},
    "nonfinite_value_count": {"const": 0},
    "zero_norm_vector_count": {"const": 0},
    "norm_violation_count": {"const": 0},
    "validation_status": {"const": "passed"}
  }
}
