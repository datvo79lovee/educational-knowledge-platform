{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://educational-knowledge-platform.local/schemas/evidence_review_a1_experiment_manifest_v1.schema.json",
  "title": "A1 Two-stage Evidence Reviewer Experiment Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "experiment_run_id", "candidate_id", "experiment_type", "scope", "architecture", "variables_frozen", "execution_config", "runtime", "operating_condition", "runs", "stability", "input_sha256", "output_artifacts", "download_performed", "ground_truth_read", "validation_status", "m2_status"],
  "properties": {
    "$schema": {"const": "../../schemas/evidence_review_a1_experiment_manifest_v1.schema.json"},
    "schema_version": {"const": "evidence_review_a1_experiment_manifest_v1"},
    "experiment_run_id": {"type": "string", "pattern": "^mit60001_evidence_a1_experiment_[a-f0-9]{16}$"},
    "candidate_id": {"const": "a1_two_stage_coverage_entailment_v1"},
    "experiment_type": {"const": "architecture_bundle"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["development_request_count", "decision_evaluable_count", "excluded_question_ids", "holdout_status"],
      "properties": {
        "development_request_count": {"const": 40},
        "decision_evaluable_count": {"const": 37},
        "excluded_question_ids": {"const": ["mit60001-q-017", "mit60001-q-023", "mit60001-q-041"]},
        "holdout_status": {"const": "not_created_not_used"}
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage1", "stage2", "stage2_normalization", "reducer"],
      "properties": {
        "stage1": {"const": "question_only_requirement_analysis"},
        "stage2": {"const": "requirement_by_evidence_entailment_without_final_decision"},
        "stage2_normalization": {"const": "deduplicate_supporting_chunk_ids_preserve_first_occurrence"},
        "reducer": {"const": "accept_iff_all_requirements_supported"}
      }
    },
    "variables_frozen": {"type": "object", "minProperties": 1},
    "execution_config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api_mode", "endpoint", "temperature", "seed", "num_predict", "num_ctx", "repeat_policy", "structured_output"],
      "properties": {
        "api_mode": {"const": "ollama_api_chat"},
        "endpoint": {"const": "http://127.0.0.1:11434"},
        "temperature": {"const": 0},
        "seed": {"const": 42},
        "num_predict": {"const": 512},
        "num_ctx": {"const": 4096},
        "repeat_policy": {"const": "primary_frozen_repeat_stability_only_no_voting"},
        "structured_output": {"const": "json_schema"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ollama_version", "model", "digest", "size_bytes", "family", "parameter_size", "quantization_level", "model_context_capability"],
      "properties": {
        "ollama_version": {"const": "0.32.14"},
        "model": {"const": "llama3.2:3b"},
        "digest": {"const": "a80c4f17acd55265feec403c7aef86be0c25983ab279d83f3bcd3abbcb5b8b72"},
        "size_bytes": {"const": 2019393189},
        "family": {"const": "llama"},
        "parameter_size": {"const": "3.2B"},
        "quantization_level": {"const": "Q4_K_M"},
        "model_context_capability": {"const": 131072}
      }
    },
    "operating_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ollama_api_ps", "ollama_cli_ps"],
      "properties": {
        "ollama_api_ps": {"type": ["object", "null"]},
        "ollama_cli_ps": {"type": ["object", "null"]}
      }
    },
    "runs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run_label", "question_count", "accept_count", "reject_count", "failure_count", "model_call_count", "duplicate_supporting_id_count", "output_artifacts"],
        "properties": {
          "run_label": {"enum": ["primary", "repeat"]},
          "question_count": {"const": 40},
          "accept_count": {"type": "integer", "minimum": 0, "maximum": 40},
          "reject_count": {"type": "integer", "minimum": 0, "maximum": 40},
          "failure_count": {"const": 0},
          "model_call_count": {"const": 80},
          "duplicate_supporting_id_count": {"type": "integer", "minimum": 0},
          "output_artifacts": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {"$ref": "#/$defs/artifact"}
          }
        }
      }
    },
    "stability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_count", "stage1_exact_match_count", "stage2_exact_match_count", "final_response_exact_match_count", "decision_change_count", "supporting_id_change_count", "best_of_or_voting_used"],
      "properties": {
        "question_count": {"const": 40},
        "stage1_exact_match_count": {"type": "integer", "minimum": 0, "maximum": 40},
        "stage2_exact_match_count": {"type": "integer", "minimum": 0, "maximum": 40},
        "final_response_exact_match_count": {"type": "integer", "minimum": 0, "maximum": 40},
        "decision_change_count": {"type": "integer", "minimum": 0, "maximum": 40},
        "supporting_id_change_count": {"type": "integer", "minimum": 0, "maximum": 40},
        "best_of_or_voting_used": {"const": false}
      }
    },
    "input_sha256": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "output_artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "download_performed": {"const": false},
    "ground_truth_read": {"const": false},
    "validation_status": {"const": "passed"},
    "m2_status": {"const": "complete_runtime_only_not_quality_evaluated"}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
