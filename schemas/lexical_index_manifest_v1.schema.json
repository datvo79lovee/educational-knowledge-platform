{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://educational-knowledge-platform.local/schemas/lexical_index_manifest_v1.schema.json",
  "title": "MIT 6.0001 Lexical Index Manifest v1",
  "description": "Audit manifest for the exact BM25 index built from canonical Gold chunks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schema_version", "index_run_id", "index_created_at_utc",
    "index_version", "scope_version", "index_backend",
    "canonical_gold_file", "canonical_gold_sha256",
    "canonical_gold_manifest_file", "canonical_gold_manifest_sha256",
    "selected_chunking_config_id", "dense_index_run_id",
    "dense_index_content_sha256", "dense_index_manifest_file",
    "dense_index_manifest_sha256", "chunk_id_order_sha256",
    "lexical_index_file", "lexical_index_sha256", "tokenizer_version",
    "token_pattern", "lowercase", "dotted_identifier_expansion", "stemming",
    "stopword_removal", "query_unique_tokens", "bm25_k1", "bm25_b",
    "score_dtype", "chunk_count", "video_count", "vocabulary_size",
    "total_token_count", "minimum_document_length", "maximum_document_length",
    "average_document_length", "posting_entry_count", "python_version",
    "validation_error_count", "validation_status"
  ],
  "properties": {
    "$schema": {"const": "../../schemas/lexical_index_manifest_v1.schema.json"},
    "schema_version": {"const": "lexical_index_manifest_v1"},
    "index_run_id": {"type": "string", "pattern": "^mit60001_lexical_[a-f0-9]{16}$"},
    "index_created_at_utc": {"type": "string", "format": "date-time"},
    "index_version": {"const": "mit60001_bm25_v1"},
    "scope_version": {"const": "mit_60001_fall_2016_v1"},
    "index_backend": {"const": "exact_bm25_inverted_index_v1"},
    "canonical_gold_file": {"const": "data/gold/mit_60001/chunks.jsonl"},
    "canonical_gold_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "canonical_gold_manifest_file": {"const": "reports/08_chunking/canonical_gold_manifest.json"},
    "canonical_gold_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "selected_chunking_config_id": {"const": "semantic_cosine_wp240_v1"},
    "dense_index_run_id": {"type": "string", "pattern": "^mit60001_index_[a-f0-9]{16}$"},
    "dense_index_content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "dense_index_manifest_file": {"const": "reports/09_embedding/embedding_index_manifest.json"},
    "dense_index_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "chunk_id_order_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "lexical_index_file": {"const": "data/indexes/mit_60001/lexical_index.json"},
    "lexical_index_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "tokenizer_version": {"const": "mit60001_python_lexical_tokenizer_v1"},
    "token_pattern": {"type": "string", "minLength": 1},
    "lowercase": {"const": true},
    "dotted_identifier_expansion": {"const": true},
    "stemming": {"const": false},
    "stopword_removal": {"const": false},
    "query_unique_tokens": {"const": true},
    "bm25_k1": {"const": 1.2},
    "bm25_b": {"const": 0.75},
    "score_dtype": {"const": "float64"},
    "chunk_count": {"const": 861},
    "video_count": {"const": 38},
    "vocabulary_size": {"type": "integer", "minimum": 1},
    "total_token_count": {"type": "integer", "minimum": 861},
    "minimum_document_length": {"type": "integer", "minimum": 1},
    "maximum_document_length": {"type": "integer", "minimum": 1},
    "average_document_length": {"type": "number", "exclusiveMinimum": 0},
    "posting_entry_count": {"type": "integer", "minimum": 1},
    "python_version": {"type": "string", "minLength": 1},
    "validation_error_count": {"const": 0},
    "validation_status": {"const": "passed"}
  }
}
