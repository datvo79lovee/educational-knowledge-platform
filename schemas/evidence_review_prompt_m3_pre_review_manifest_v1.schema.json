{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://educational-knowledge-platform.local/schemas/evidence_review_prompt_m3_pre_review_manifest_v1.schema.json",
  "title": "Evidence Review Prompt M3 Pre-review Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "m3_run_id", "frozen_experiment_run_id", "evaluation_scope", "decision_metrics", "evidence_audit", "threshold_status", "input_sha256", "output_artifacts", "ground_truth_modified", "prompt_or_model_modified", "additional_exclusions_created", "validation_status", "m3_status"],
  "properties": {
    "$schema": {"const": "../../schemas/evidence_review_prompt_m3_pre_review_manifest_v1.schema.json"},
    "schema_version": {"const": "evidence_review_prompt_m3_pre_review_manifest_v1"},
    "m3_run_id": {"type": "string", "pattern": "^mit60001_evidence_prompt_m3_[a-f0-9]{16}$"},
    "frozen_experiment_run_id": {"const": "mit60001_evidence_prompt_experiment_256f435e9d3e0bfd"},
    "evaluation_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_question_count", "evaluated_question_count", "excluded_question_ids"],
      "properties": {
        "total_question_count": {"const": 40},
        "evaluated_question_count": {"const": 37},
        "excluded_question_ids": {
          "const": ["mit60001-q-017", "mit60001-q-023", "mit60001-q-041"]
        }
      }
    },
    "decision_metrics": {"type": "object", "required": ["locked_baseline_e0", "current_control_e1", "candidate_v2_e2"]},
    "evidence_audit": {"type": "object", "required": ["unique_selection_pair_count", "canonical_reuse_count", "pending_human_review_count"]},
    "threshold_status": {"type": "object", "required": ["decision_thresholds", "evidence_threshold", "overall"]},
    "input_sha256": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "output_artifacts": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "sha256"],
        "properties": {
          "file": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "ground_truth_modified": {"const": false},
    "prompt_or_model_modified": {"const": false},
    "additional_exclusions_created": {"const": false},
    "validation_status": {"const": "passed"},
    "m3_status": {"const": "human_evidence_review_pending"}
  }
}
