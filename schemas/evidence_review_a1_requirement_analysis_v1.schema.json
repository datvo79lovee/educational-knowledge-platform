{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://educational-knowledge-platform.local/schemas/evidence_review_a1_requirement_analysis_v1.schema.json",
  "title": "A1 Requirement Analysis v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["requirements"],
  "properties": {
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id", "requirement"],
        "properties": {
          "requirement_id": {"type": "string", "pattern": "^r[1-8]$"},
          "requirement": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
