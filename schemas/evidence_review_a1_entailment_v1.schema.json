{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://educational-knowledge-platform.local/schemas/evidence_review_a1_entailment_v1.schema.json",
  "title": "A1 Requirement Evidence Entailment v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["assessments"],
  "properties": {
    "assessments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id", "supported", "supporting_chunk_ids", "entailment_reason"],
        "properties": {
          "requirement_id": {"type": "string", "pattern": "^r[1-8]$"},
          "supported": {"type": "boolean"},
          "supporting_chunk_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "entailment_reason": {"type": "string", "minLength": 1}
        },
        "allOf": [
          {
            "if": {"properties": {"supported": {"const": true}}, "required": ["supported"]},
            "then": {"properties": {"supporting_chunk_ids": {"minItems": 1}}}
          },
          {
            "if": {"properties": {"supported": {"const": false}}, "required": ["supported"]},
            "then": {"properties": {"supporting_chunk_ids": {"maxItems": 0}}}
          }
        ]
      }
    }
  }
}
