{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://educational-knowledge-platform.local/schemas/multilingual_paired_intent_v1.schema.json",
  "title": "MIT 6.0001 Multilingual Paired Intent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "intent_id",
    "question_en",
    "question_vi",
    "literal_en",
    "intent_type",
    "source_category",
    "ground_truth_ranges",
    "relevant_chunk_ids",
    "evidence_shape",
    "translation_status",
    "review_status",
    "reviewer",
    "reviewed_at",
    "review_notes"
  ],
  "properties": {
    "schema_version": {"const": "multilingual_paired_intent_v1"},
    "intent_id": {"type": "string", "pattern": "^mit60001-q-[0-9]{3}$"},
    "question_en": {"type": "string", "minLength": 5},
    "question_vi": {"type": "string", "minLength": 5},
    "literal_en": {"type": "string", "minLength": 5},
    "intent_type": {
      "enum": ["what", "how", "why", "comparison", "procedure", "concept_relationship", "multi_point"]
    },
    "source_category": {
      "enum": ["factual", "concept_explanation", "code_behavior", "multi_chunk", "confusable"]
    },
    "ground_truth_ranges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["video_id", "start_second", "end_second"],
        "properties": {
          "video_id": {"type": "string", "minLength": 1},
          "start_second": {"type": "number", "minimum": 0},
          "end_second": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    },
    "relevant_chunk_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "evidence_shape": {"enum": ["single_chunk", "multiple_chunks"]},
    "translation_status": {
      "enum": ["initial_model_output", "regenerated_after_pre_review_drift"]
    },
    "review_status": {
      "enum": ["Pending human review", "Equivalent", "Minor wording difference", "Semantic drift"]
    },
    "reviewer": {"type": ["string", "null"]},
    "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
    "review_notes": {"type": "string"}
  }
}
