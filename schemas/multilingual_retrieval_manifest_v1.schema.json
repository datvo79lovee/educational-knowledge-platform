  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "multilingual_retrieval_manifest_v1"},
    "artifact_version": {"const": "mit_60001_multilingual_m2_v1"},
    "status": {"const": "retrieval_complete"},
    "retrieval_run_id": {"type": "string"},
    "m1": {"type": "object"},
    "index": {"type": "object"},
    "retrieval": {"type": "object"},
    "execution": {"type": "object"},
    "validation": {"type": "object"},
    "artifacts": {"type": "object"},
    "software": {"type": "object"},
    "validation_status": {"const": "passed"}
  }
}
