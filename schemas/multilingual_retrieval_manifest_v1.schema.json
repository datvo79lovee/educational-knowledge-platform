{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://educational-knowledge-platform.local/schemas/multilingual_retrieval_manifest_v1.schema.json",
  "title": "MIT 6.0001 Multilingual Dense Retrieval M2 Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "artifact_version",
    "status",
    "retrieval_run_id",
    "m1",
    "index",
    "retrieval",
    "execution",
    "validation",
    "artifacts",
    "software",
    "validation_status"
