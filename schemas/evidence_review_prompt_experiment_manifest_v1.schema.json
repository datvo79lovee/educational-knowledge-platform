{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://educational-knowledge-platform.local/schemas/evidence_review_prompt_experiment_manifest_v1.schema.json",
  "title": "Evidence Review Prompt Experiment Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "experiment_run_id", "experiment_scope", "baseline_reference", "runtime", "execution_config", "input_sha256", "variants", "comparison", "validation_status"],
  "properties": {
    "$schema": {"const": "../../schemas/evidence_review_prompt_experiment_manifest_v1.schema.json"},
    "schema_version": {"const": "evidence_review_prompt_experiment_manifest_v1"},
    "experiment_run_id": {"type": "string", "pattern": "^mit60001_evidence_prompt_experiment_[a-f0-9]{16}$"},
    "experiment_scope": {"const": "provider_independent_prompt_comparison_without_ground_truth"},
    "baseline_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_run_id", "manifest_sha256"],
      "properties": {
        "runtime_run_id": {"const": "mit60001_evidence_reviewer_0ee5e6a1362fc5c4"},
        "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ollama_version", "model", "digest", "size_bytes", "family", "parameter_size", "quantization_level"],
      "properties": {
        "ollama_version": {"type": "string", "minLength": 1},
        "model": {"const": "llama3.2:3b"},
        "digest": {"const": "a80c4f17acd55265feec403c7aef86be0c25983ab279d83f3bcd3abbcb5b8b72"},
        "size_bytes": {"const": 2019393189},
        "family": {"const": "llama"},
        "parameter_size": {"const": "3.2B"},
        "quantization_level": {"const": "Q4_K_M"}
      }
    },
    "execution_config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api_mode", "endpoint", "temperature", "seed", "num_predict", "structured_output_schema_version", "contract_version"],
      "properties": {
        "api_mode": {"const": "ollama_api_chat"},
        "endpoint": {"const": "http://127.0.0.1:11434"},
        "temperature": {"const": 0},
        "seed": {"const": 42},
        "num_predict": {"const": 512},
        "structured_output_schema_version": {"const": "evidence_review_response_v1"},
        "contract_version": {"const": "retrieval_evidence_review_contract_v2"}
      }
    },
    "input_sha256": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    },
    "variants": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/variant"}
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_count", "same_top3_count", "decision_change_count", "supporting_id_change_count"],
      "properties": {
        "question_count": {"const": 40},
        "same_top3_count": {"const": 40},
        "decision_change_count": {"type": "integer", "minimum": 0, "maximum": 40},
        "supporting_id_change_count": {"type": "integer", "minimum": 0, "maximum": 40}
      }
    },
    "validation_status": {"const": "passed"}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variant_id", "prompt_version", "system_prompt_sha256", "runtime_run_id", "question_count", "accept_count", "reject_count", "failure_count", "output_artifacts"],
      "properties": {
        "variant_id": {"enum": ["control_v1", "candidate_v2"]},
        "prompt_version": {"enum": ["evidence_review_prompt_v1", "evidence_review_prompt_v2_complete_coverage"]},
        "system_prompt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "runtime_run_id": {"type": "string", "pattern": "^mit60001_evidence_reviewer_experiment_[a-f0-9]{16}$"},
        "question_count": {"const": 40},
        "accept_count": {"type": "integer", "minimum": 0, "maximum": 40},
        "reject_count": {"type": "integer", "minimum": 0, "maximum": 40},
        "failure_count": {"const": 0},
        "output_artifacts": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/artifact"}
        }
      }
    }
  }
}
